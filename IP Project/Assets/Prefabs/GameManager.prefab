    - target: {fileID: 7577239673155844216, guid: 3cfacc742b25c204e960522cbcf44a82, type: 3}
      propertyPath: dialogueCanvas
      value: 
      objectReference: {fileID: 4112726860284974020}
    - target: {fileID: 7577239673155844216, guid: 3cfacc742b25c204e960522cbcf44a82, type: 3}
      propertyPath: names.Array.size
      value: 11
      objectReference: {fileID: 0}
    - target: {fileID: 7577239673155844216, guid: 3cfacc742b25c204e960522cbcf44a82, type: 3}
      propertyPath: 'names.Array.data[6]'
      value: Police Officer
      objectReference: {fileID: 0}
    - target: {fileID: 7577239673155844216, guid: 3cfacc742b25c204e960522cbcf44a82, type: 3}
      propertyPath: 'names.Array.data[10]'
      value: Benny
      objectReference: {fileID: 0}
    - target: {fileID: 7577239673155844216, guid: 3cfacc742b25c204e960522cbcf44a82, type: 3}
      propertyPath: sentences.Array.size
      value: 11
      objectReference: {fileID: 0}
    - target: {fileID: 7577239673155844216, guid: 3cfacc742b25c204e960522cbcf44a82, type: 3}
      propertyPath: 'sentences.Array.data[5]'
      value: But I'm glad I didn't let them influence me. I realised how kind-hearted
        and how you geniunely care about about this neighbourhood and the safety
        of people.
      objectReference: {fileID: 0}
    - target: {fileID: 7577239673155844216, guid: 3cfacc742b25c204e960522cbcf44a82, type: 3}
      propertyPath: 'sentences.Array.data[6]'
      value: Aw shucks! You're being too kind!
      objectReference: {fileID: 0}
    - target: {fileID: 7577239673155844216, guid: 3cfacc742b25c204e960522cbcf44a82, type: 3}
      propertyPath: 'sentences.Array.data[7]'
      value: This is just what I do and my responsiblity as a police officer.
      objectReference: {fileID: 0}
    - target: {fileID: 7577239673155844216, guid: 3cfacc742b25c204e960522cbcf44a82, type: 3}
      propertyPath: 'sentences.Array.data[8]'
      value: I hope your friends can come to trust and accept the police as well.
        We are suppose to be the protectors afterall.
      objectReference: {fileID: 0}
    - target: {fileID: 7577239673155844216, guid: 3cfacc742b25c204e960522cbcf44a82, type: 3}
      propertyPath: 'sentences.Array.data[9]'
      value: Oh yeah! There is a coffee with a cop session this weekend. Bring your
        friends along and we could talk it out.
      objectReference: {fileID: 0}
    - target: {fileID: 7577239673155844216, guid: 3cfacc742b25c204e960522cbcf44a82, type: 3}
      propertyPath: 'sentences.Array.data[10]'
      value: I will.
      objectReference: {fileID: 0}
